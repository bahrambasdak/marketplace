# Copy to .env and replace the local-only password before starting PostgreSQL.
# Never commit real credentials. Keep runtime-specific variables documented with their owner.
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=marketplace
POSTGRES_PORT=5432
DATABASE_URL=postgresql://marketplace:replace-with-a-local-password@localhost:5432/marketplace?schema=public
